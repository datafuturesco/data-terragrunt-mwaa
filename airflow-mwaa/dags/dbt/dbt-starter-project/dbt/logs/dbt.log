create or replace transient table AIRFLOW.DEV.dim_listings_w_hosts
         as
        (WITH l AS (
    SELECT * FROM AIRFLOW.DEV.dim_listings_cleansed
), 
h AS (
    SELECT * FROM AIRFLOW.DEV.dim_hosts_cleansed
)

SELECT 
    l.listing_id,
    l.listing_name,
    l.room_type,
    l.minimum_nights,
    l.price,
    l.host_id,
    h.host_name,
    h.is_superhost AS host_is_superhost,
    l.created_at,
